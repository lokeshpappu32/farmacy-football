SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_DAYS=90
ADMIN_SECRET_CODE=HETERO-ADMIN-2026
# Format: user_id|password|display name;second_user|password|display name
ADMIN_CREDENTIALS=admin@example.com|change-this-admin-password|Admin User
# Alternative JSON format if preferred:
# ADMIN_CREDENTIALS_JSON={"admin@example.com":{"password":"change-this-admin-password","name":"Admin User"}}
SUPER_ADMIN_USER_ID=superadmin
SUPER_ADMIN_PASSWORD=change-this-super-admin-password

# Azure SQL Server.
# Recommended for Azure App Service Configuration:
AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=your-db;Uid=your-user;Pwd=your-password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Alternative full SQLAlchemy URL if you prefer DATABASE_URL instead of AZURE_SQL_CONNECTION_STRING:
# DATABASE_URL=mssql+pyodbc://USERNAME:PASSWORD@your-server.database.windows.net:1433/your-db?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Local MySQL development backup is kept under .backup/local-mysql-* when switching deployment modes.

PUBLIC_APP_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000

FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_COMPETITION=WC
FOOTBALLDATA_IO_API_KEY=
FOOTBALLDATA_IO_BASE_URL=https://footballdata.io/api/v1
FOOTBALLDATA_IO_LEAGUE_IDS=50
FOOTBALLDATA_IO_SEASON_ID=618
FOOTBALLDATA_IO_LANG=en
FOOTBALLDATA_IO_SYNC_ENABLED=false
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
