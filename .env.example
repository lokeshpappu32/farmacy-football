SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
ADMIN_SECRET_CODE=HETERO-ADMIN-2026

# Azure SQL Database example. URL-encode special characters in username/password.
# DATABASE_URL=mssql+pyodbc://user:password@server.database.windows.net:1433/farmacy_football?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Alternative Azure SQL ODBC-style connection string. Use this if the URL format is difficult because of special characters.
# AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:server.database.windows.net,1433;Database=farmacy_football;Uid=user;Pwd=password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# PostgreSQL example.
# DATABASE_URL=postgresql://user:password@host:5432/farmacy_football

# Local MySQL development example, only if you switch requirements back to PyMySQL:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/farmacy_football

PUBLIC_APP_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000

FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_COMPETITION=WC
FOOTBALLDATA_IO_API_KEY=
FOOTBALLDATA_IO_BASE_URL=https://footballdata.io/api/v1
FOOTBALLDATA_IO_LEAGUE_IDS=50
FOOTBALLDATA_IO_SEASON_ID=618
FOOTBALLDATA_IO_LANG=en
FOOTBALLDATA_IO_SYNC_ENABLED=false
